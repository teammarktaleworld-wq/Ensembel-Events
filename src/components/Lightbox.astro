<div id="lightbox" class="lightbox fixed inset-0 z-[130]" hidden>
  <div class="lb-scrim absolute inset-0 bg-[#0b0b0d]/95" data-lb-close></div>
  <div class="absolute inset-0 flex items-center justify-center px-3 pt-16 pb-24 sm:px-24 sm:pb-20" role="dialog" aria-modal="true" aria-label="Media viewer">
    <figure class="lb-figure relative flex max-h-full max-w-full flex-col items-center">
      <div class="lb-media overflow-hidden rounded-xl bg-black"></div>
      <figcaption class="lb-cap mt-4 text-center text-sm text-white/80"></figcaption>
    </figure>
  </div>
  <p class="lb-count absolute top-5 left-5 text-sm text-white/70" aria-live="polite"></p>
  <button type="button" class="lb-btn lb-close absolute top-3 right-3" aria-label="Close viewer">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
  <button type="button" class="lb-btn lb-prev absolute bottom-6 left-1/2 -translate-x-[120%] sm:top-1/2 sm:bottom-auto sm:left-5 sm:translate-x-0 sm:-translate-y-1/2" aria-label="Previous">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
  </button>
  <button type="button" class="lb-btn lb-next absolute bottom-6 left-1/2 translate-x-[20%] sm:top-1/2 sm:right-5 sm:bottom-auto sm:left-auto sm:translate-x-0 sm:-translate-y-1/2" aria-label="Next">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
  </button>
</div>

<style>
  .lb-btn { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 999px; color: #fff; background: rgb(255 255 255 / 0.1); border: 1px solid rgb(255 255 255 / 0.2); transition: background-color 0.3s, border-color 0.3s; }
  .lb-btn:hover { background: rgb(255 255 255 / 0.2); border-color: var(--accent); }
  .lb-media :global(img), .lb-media :global(video) { display: block; max-width: min(92vw, 1280px); max-height: calc(100svh - 12rem); width: auto; height: auto; }
</style>
