---
import { categories, wall, heroWall } from '../data/site';
import { byId } from '../data/media';
import Tile from './Tile.astro';

// Category cells fill from `wall.all` in order; wedding cells are fixed.
let next = 0;
const slots = heroWall.map((id) => (id === 'cat' ? { m: byId[wall.all[next++]], fixed: false } : { m: byId[id], fixed: true }));
const sizes = '(min-width: 1200px) 24vw, (min-width: 768px) 30vw, 50vw';
const play = '<svg width="9" height="9" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 1l7 4-7 4z" fill="currentColor"/></svg>';
---

<section id="top" class="hero relative overflow-x-clip" aria-labelledby="hero-title">
  <div class="wrap">
    <div id="wall" class="wall">
      <div class="hero-card">
        <p class="eyebrow hero-fade">Event management · New Delhi · Since 2008</p>
        <h1 id="hero-title" class="mt-3 text-[clamp(3rem,6vw,6rem)] leading-[0.95]">
          <span class="line-mask"><span class="hero-line block">You dream.</span></span>
          <span class="line-mask"><span class="hero-line block"><em>We make.</em></span></span>
        </h1>
        <div class="hero-fade mt-5 chip-row" role="group" aria-label="Show events by type">
          {categories.map((c, i) => (
            <button type="button" class="chip" data-cat-btn data-cat={c.id} aria-pressed={i === 0 ? 'true' : 'false'}><span class="dot"></span>{c.label}</button>
          ))}
        </div>
      </div>

      {slots.map(({ m, fixed }, i) => (
        <button type="button" class:list={['tile', { 'wide-only': i >= slots.length - 2 }]} data-id={m.id} data-fixed={fixed ? '' : undefined} aria-label={`View: ${m.caption}`}>
          <span class="tile-inner"><Tile m={m} eager={i < 7} sizes={sizes} /></span>
          <span class="tile-badge" hidden={m.type !== 'video'}><span class="tile-badge-icon" set:html={play} />Video</span>
          <span class="tile-cap">{m.caption}</span>
        </button>
      ))}
    </div>

    <div class="hero-fade hero-foot">
      <p class="hidden sm:block">Corporate · Government · Media · Launches · Concerts · Weddings, across India</p>
      <button type="button" class="pause-btn ml-auto inline-flex min-h-11 items-center gap-2 rounded-full px-3 font-medium text-ink/70 hover:text-ink" aria-pressed="false">
        <span class="pause-icon" aria-hidden="true"></span><span class="pause-label">Pause videos</span>
      </button>
    </div>
  </div>
</section>

<style>
  /* The page's background threads stay hidden while the first screen is in view (set in wall.ts). */
  :global(.backdrop) { transition: opacity 0.9s var(--ease-out); }
  :global(html:not(.past-hero) .backdrop) { opacity: 0; }

  .hero { padding-top: calc(4.75rem + 0.75rem); }

  /* Phones and tablets: card on top, then an even grid of 12 photos (2 or 4 per row). */
  .wall { display: grid; gap: 16px; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-inline: auto; }
  .wide-only { display: none; }

  .hero-card {
    grid-column: 1 / -1; position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 2.25rem 1.25rem; text-align: center; border-radius: 14px; border: 1px solid var(--color-line);
    background: radial-gradient(90% 70% at 50% 0%, rgb(247 227 173 / 0.35), transparent 70%), #fffdf8;
    box-shadow: 0 1px 2px rgb(20 20 22 / 0.04), 0 18px 40px -28px rgb(120 84 0 / 0.35);
  }
  /* Thin gold frame inside the card. */
  .hero-card::before {
    content: ''; position: absolute; inset: 7px; border-radius: 9px; pointer-events: none; border: 1px solid rgb(227 168 28 / 0.22);
  }
  .hero-card .eyebrow::after { content: ''; width: 1.75rem; height: 1px; background: var(--accent); }
  .hero-card .chip-row { max-width: 100%; }
  :global(.js-motion) .tile, :global(.js-motion) .hero-card { opacity: 0; }

  /* Photo cells: all 4:3, 16px gaps, the same corners. */
  .tile {
    position: relative; display: block; align-self: start; aspect-ratio: 4 / 3; overflow: hidden; border-radius: 14px;
    background: var(--color-paper-2); color: #fff; text-align: left; isolation: isolate;
    box-shadow: 0 1px 2px rgb(20 20 22 / 0.06), 0 12px 28px -18px rgb(20 20 22 / 0.35);
  }
  .tile::after {
    content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; z-index: 3;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08); transition: box-shadow 0.4s var(--ease-out);
  }
  .tile:hover::after, .tile:focus-visible::after { box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08), inset 0 -2px 0 0 var(--accent); }
  .tile:focus-visible { outline-offset: 4px; border-radius: 14px; }
  .tile-inner { position: absolute; inset: 0; display: block; }
  .tile :global(.media-fit) { object-fit: cover; object-position: center; transition: transform 1.2s var(--ease-out); }
  .tile:hover :global(.media-fit) { transform: scale(1.04); }

  .tile-cap {
    position: absolute; inset: auto 0 0 0; z-index: 2; padding: 2.75rem 1rem 0.85rem; font-size: 0.82rem; font-weight: 500; letter-spacing: 0.01em;
    background: linear-gradient(transparent, rgb(12 10 8 / 0.7)); opacity: 0; transform: translateY(6px); transition: opacity 0.4s, transform 0.4s var(--ease-out);
  }
  .tile:hover .tile-cap, .tile:focus-visible .tile-cap { opacity: 1; transform: none; }

  /* Video badge: always top-left, one style. */
  .tile-badge {
    position: absolute; top: 10px; left: 10px; z-index: 2; display: inline-flex; align-items: center; gap: 0.4rem; height: 1.5rem; padding: 0 0.6rem 0 0.5rem;
    border-radius: 999px; background: rgb(20 20 22 / 0.58); font-size: 0.68rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
  }
  .tile-badge-icon { display: inline-grid; place-items: center; width: 0.95rem; height: 0.95rem; border-radius: 999px; background: var(--accent); color: var(--color-ink); padding-left: 1px; }
  .tile-badge[hidden] { display: none; }

  .hero-foot { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 0.6rem; font-size: 0.875rem; color: rgb(20 20 22 / 0.6); }

  .pause-icon { position: relative; width: 0.75rem; height: 0.75rem; }
  .pause-icon::before, .pause-icon::after { content: ''; position: absolute; top: 0; bottom: 0; width: 3px; border-radius: 1px; background: currentColor; }
  .pause-icon::before { left: 1px; }
  .pause-icon::after { right: 1px; }
  .pause-btn[aria-pressed='true'] .pause-icon::before { left: 2px; right: 0; width: auto; background: none; border-left: 0.6rem solid currentColor; border-top: 0.375rem solid transparent; border-bottom: 0.375rem solid transparent; }
  .pause-btn[aria-pressed='true'] .pause-icon::after { display: none; }

  @media (min-width: 768px) {
    .wall { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .hero-card { padding: 2.5rem 2rem; }
  }

  /* Desktop: 5 × 4 grid, card in the middle 3 × 2, 14 photos around it.
     The grid is narrowed on short screens so the whole first page fits, but never below 1180px wide
     so the card always has room for its text. */
  @media (min-width: 1200px) {
    .wall {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      max-width: min(100%, max(1180px, calc((100svh - 9.5rem) / 0.6)));
    }
    .wide-only { display: block; }
    .hero-card { grid-area: 2 / 2 / 4 / 5; align-self: stretch; padding: 1rem 1.5rem; }
    .hero-foot { max-width: min(100%, max(1180px, calc((100svh - 9.5rem) / 0.6))); margin-inline: auto; }
  }
</style>
