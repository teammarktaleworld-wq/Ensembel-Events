---
import { media } from '../data/media';
import { categories } from '../data/site';
const items = media.filter((m) => m.id !== 'almora-a' && m.id !== 'almora-c');
const span = (i: number) => (i % 9 === 0 ? 'g-big' : i % 9 === 4 ? 'g-wide' : i % 9 === 6 ? 'g-tall' : '');
const play = '<svg width="18" height="18" viewBox="0 0 10 10" aria-hidden="true"><path d="M2.5 1.5l6 3.5-6 3.5z" fill="currentColor"/></svg>';
---

<section id="work" class="relative py-20 sm:py-28" aria-labelledby="work-title">
  <div class="wrap">
    <div class="text-center">
      <p class="eyebrow justify-center" data-reveal>Our work</p>
      <h2 id="work-title" class="h2 mt-4" data-split>Straight from the <em>floor</em>.</h2>
      <div class="mt-8 chip-row" role="group" aria-label="Filter work by event type" data-reveal>
        {categories.map((c, i) => (
          <button type="button" class="chip" data-cat-btn data-cat={c.id} aria-pressed={i === 0 ? 'true' : 'false'}><span class="dot"></span>{c.label}</button>
        ))}
      </div>
    </div>

    <ul class="gallery mt-10">
      {items.map((m, i) => (
        <li class={`g-item ${span(i)}${i >= 12 ? ' is-extra' : ''}`} data-cats={m.cats.join(' ')} data-id={m.id}>
          <button type="button" class="g-btn" aria-label={`Open: ${m.caption}`}>
            <img src={m.thumb} srcset={m.type === 'image' ? `${m.thumb} 640w, ${m.src} 1280w` : undefined} sizes="(min-width: 1024px) 25vw, 50vw" alt={m.alt} width={m.w} height={m.h} loading="lazy" decoding="async" class="media-fit" />
            {m.type === 'video' && <span class="g-play" set:html={play} />}
            <span class="g-cap">{m.caption}</span>
          </button>
        </li>
      ))}
    </ul>

    <div class="mt-10 text-center">
      <button type="button" class="btn-ghost g-more">Show all {items.length}</button>
    </div>
  </div>
</section>

<style>
  .gallery { display: grid; gap: 8px; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 9.5rem; grid-auto-flow: dense; }
  .g-item.is-hidden, :global(html.js) .gallery:not(.show-all) .g-item.is-extra { display: none; }
  .g-big { grid-column: span 2; grid-row: span 2; }
  .g-wide { grid-column: span 2; }
  .g-tall { grid-row: span 2; }
  .g-btn { position: relative; display: block; width: 100%; height: 100%; overflow: hidden; border-radius: 14px; background: var(--color-paper-2); }
  .g-btn :global(.media-fit) { transition: transform 1.2s var(--ease-out); }
  .g-btn:hover :global(.media-fit) { transform: scale(1.06); }
  .g-cap {
    position: absolute; inset: auto 0 0 0; padding: 2.4rem 0.9rem 0.75rem; color: #fff; font-size: 0.85rem; font-weight: 500; text-align: left;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.65)); opacity: 0; transform: translateY(6px); transition: opacity 0.4s, transform 0.4s;
  }
  .g-btn:hover .g-cap, .g-btn:focus-visible .g-cap { opacity: 1; transform: none; }
  .g-play {
    position: absolute; top: 50%; left: 50%; display: grid; place-items: center; width: 3.25rem; height: 3.25rem; margin: -1.625rem 0 0 -1.625rem;
    border-radius: 999px; background: rgb(255 255 255 / 0.9); color: var(--color-ink); box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.5);
  }
  @media (hover: none) { .g-cap { opacity: 1; transform: none; } }
  @media (min-width: 768px) { .gallery { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: 12rem; } }
  @media (min-width: 1024px) { .gallery { grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: 14rem; gap: 10px; } }
</style>
