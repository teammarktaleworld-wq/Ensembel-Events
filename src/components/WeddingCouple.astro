---
import { wedding } from '../data/site';

type Pt = { x: number; y: number };
const ROSE = ['rose', 'jasmine', 'marigold', 'blush'];

// Flowers along a U-shaped garland hanging between two points.
function garland(x0: number, x1: number, top: number, depth: number, n: number, size = 8) {
  const cx = (x0 + x1) / 2;
  return Array.from({ length: n + 1 }, (_, i) => {
    const t = i / n;
    const x = (1 - t) ** 2 * x0 + 2 * (1 - t) * t * cx + t * t * x1;
    const y = (1 - t) ** 2 * top + 2 * (1 - t) * t * (top + depth * 2) + t * t * top;
    return { x: +x.toFixed(1), y: +y.toFixed(1), r: size + (i % 3 === 0 ? 1.5 : 0), kind: ROSE[i % 4] };
  });
}

// Floral arch: two legs and a semicircle, two staggered layers of blooms with leaves.
const arch: { x: number; y: number; r: number; kind: string; leaf?: number }[] = [];
const ARCH_R = 300;
const ARCH_Y = 430;
const archPath = (s: number): Pt => {
  const leg = 960 - ARCH_Y;
  const arc = Math.PI * ARCH_R;
  const total = leg * 2 + arc;
  const d = s * total;
  if (d < leg) return { x: 600 - ARCH_R, y: 960 - d };
  if (d < leg + arc) {
    const a = Math.PI - (d - leg) / ARCH_R;
    return { x: 600 + Math.cos(a) * ARCH_R, y: ARCH_Y - Math.sin(a) * ARCH_R };
  }
  return { x: 600 + ARCH_R, y: ARCH_Y + (d - leg - arc) };
};
for (let i = 0; i <= 130; i++) {
  const p = archPath(i / 130);
  const jitter = (k: number) => Math.sin(i * 12.9898 + k) * 9;
  arch.push({ x: p.x + jitter(1), y: p.y + jitter(2), r: 14 + (i % 3) * 3, kind: ROSE[(i * 3) % 4] });
  if (i % 2 === 0) arch.push({ x: p.x - jitter(3) * 1.4, y: p.y - jitter(4) * 1.4, r: 9, kind: 'leaf', leaf: (i * 37) % 180 });
}
const strands = [390, 440, 590, 640, 760, 810].map((x, i) => {
  const top = ARCH_Y - Math.sqrt(Math.max(0, ARCH_R ** 2 - (x - 600) ** 2)) + 12;
  const len = 70 + ((i * 53) % 90);
  return Array.from({ length: Math.floor(len / 13) }, (_, k) => ({ x, y: top + k * 13 }));
});

const groomHeld = garland(536, 590, 478, 70, 16, 7.5);
const brideHeld = garland(632, 682, 486, 70, 16, 7.5);
const groomWorn = garland(466, 512, 316, 120, 22, 8);
const brideWorn = garland(708, 748, 344, 112, 22, 8);
const mala = garland(468, 508, 318, 60, 16, 3.2);

const pleats = Array.from({ length: 15 }, (_, i) => {
  const top = 690 + i * 4.2;
  const bottom = 584 + i * 21.5;
  return `M${top} 556 Q${(top + bottom) / 2 + (i - 7) * 4} 760 ${bottom} 944`;
});
const mandala = Array.from({ length: 24 }, (_, i) => i * 15);
const petals = Array.from({ length: 22 }, (_, i) => ({
  x: 60 + ((i * 197) % 1080), delay: -((i * 1.7) % 11), dur: 9 + (i % 5) * 1.6, kind: ['#e0284a', '#f29bb0', '#ffc22e', '#ffffff'][i % 4], s: 0.7 + (i % 3) * 0.25,
}));
const bursts = Array.from({ length: 14 }, (_, i) => ({ a: (i / 14) * Math.PI * 2, d: 60 + (i % 3) * 22, c: ['#e0284a', '#ffc22e', '#f29bb0', '#ffffff'][i % 4] }));
const diyas = [250, 340, 860, 950];
