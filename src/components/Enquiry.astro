---
import { eventTypes, budgets } from '../data/site';
const input = 'mt-1.5 block w-full rounded-xl border border-line bg-white px-4 py-3 text-base text-ink transition-colors hover:border-ink/25 focus:border-accent-ink aria-[invalid=true]:border-[#b42318]';
const label = 'block text-sm font-medium text-ink/80';
---

<div id="enquiry" class="drawer fixed inset-0 z-[120]" hidden>
  <div class="drawer-scrim absolute inset-0 bg-ink/45 backdrop-blur-[2px]" data-drawer-close></div>
  <div class="drawer-panel absolute inset-x-0 bottom-0 max-h-[92svh] overflow-y-auto overscroll-contain rounded-t-[24px] bg-paper sm:inset-y-0 sm:left-auto sm:max-h-none sm:w-[36rem] sm:rounded-none sm:rounded-l-[24px]" role="dialog" aria-modal="true" aria-labelledby="enquiry-title" data-lenis-prevent>
    <div class="sticky top-0 z-[1] flex items-center justify-between gap-4 border-b border-line bg-paper/95 px-6 py-4 backdrop-blur sm:px-8">
      <h2 id="enquiry-title" class="font-display text-xl font-semibold tracking-tight">Tell us about your event</h2>
      <button type="button" class="grid h-11 w-11 place-items-center rounded-full border border-line hover:border-ink/30" data-drawer-close aria-label="Close enquiry form">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>

    <div class="px-6 py-6 sm:px-8">
      <form id="enquiry-form" novalidate>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="f-name" class={label}>Full name <span class="text-accent-ink" aria-hidden="true">*</span></label>
            <input id="f-name" name="name" type="text" autocomplete="name" required class={input} aria-describedby="err-name" />
            <p id="err-name" class="mt-1 text-sm text-[#b42318]" hidden>Please enter your name.</p>
          </div>
          <div>
            <label for="f-phone" class={label}>Phone <span class="text-accent-ink" aria-hidden="true">*</span></label>
            <input id="f-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required class={input} aria-describedby="err-phone" />
            <p id="err-phone" class="mt-1 text-sm text-[#b42318]" hidden>Please enter a valid phone number.</p>
          </div>
          <div class="sm:col-span-2">
            <label for="f-email" class={label}>Work email <span class="text-accent-ink" aria-hidden="true">*</span></label>
            <input id="f-email" name="email" type="email" autocomplete="email" required class={input} aria-describedby="err-email" />
            <p id="err-email" class="mt-1 text-sm text-[#b42318]" hidden>Please enter a valid email address.</p>
          </div>
          <div>
            <label for="f-type" class={label}>Event type</label>
            <select id="f-type" name="eventType" class={input}>
              <option value="">Select</option>
              {eventTypes.map((t) => <option>{t}</option>)}
            </select>
          </div>
          <div>
            <label for="f-date" class={label}>Event date</label>
            <input id="f-date" name="date" type="date" class={input} />
          </div>
          <div>
            <label for="f-city" class={label}>City</label>
            <input id="f-city" name="city" type="text" autocomplete="address-level2" class={input} />
          </div>
          <div>
            <label for="f-guests" class={label}>Expected guests</label>
            <input id="f-guests" name="guests" type="number" min="1" inputmode="numeric" class={input} />
          </div>
          <div class="sm:col-span-2">
            <label for="f-budget" class={label}>Budget range</label>
            <select id="f-budget" name="budget" class={input}>
              <option value="">Select</option>
              {budgets.map((b) => <option>{b}</option>)}
            </select>
          </div>
          <div class="sm:col-span-2">
            <label for="f-org" class={label}>Organisation</label>
            <input id="f-org" name="organisation" type="text" autocomplete="organization" class={input} />
          </div>
          <div class="sm:col-span-2">
            <label for="f-msg" class={label}>Anything else?</label>
            <textarea id="f-msg" name="message" rows="3" class={`${input} resize-y`}></textarea>
          </div>
        </div>
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label for="f-website">Website</label>
          <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <button type="submit" class="btn-accent mt-6 w-full">Send enquiry</button>
        <p class="mt-3 text-center text-sm text-ink/60">We only use your details to respond to this enquiry.</p>
      </form>

      <div id="enquiry-success" class="py-16 text-center" role="status" tabindex="-1" hidden>
        <span class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-accent-soft text-accent-ink" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 12 5 5L20 7" /></svg>
        </span>
        <p class="mt-6 font-display text-2xl font-semibold tracking-tight">Thank you. We'll respond within one working day.</p>
        <button type="button" class="btn-ghost mt-8" data-drawer-close>Close</button>
      </div>
    </div>
  </div>
</div>
