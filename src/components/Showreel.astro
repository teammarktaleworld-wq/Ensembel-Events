---
import { reels } from '../data/site';
import { byId } from '../data/media';
const first = byId[reels[0].id];
---

<section id="showreel" class="relative py-20 sm:py-28" aria-labelledby="reel-title">
  <div class="wrap text-center">
    <p class="eyebrow justify-center" data-reveal>Showreel</p>
    <h2 id="reel-title" class="h2 mt-4" data-split>See it <em>live</em>.</h2>
  </div>

  <div class="wrap mt-12">
    <div class="cinema mx-auto max-w-[1180px]">
      <div class="screen relative aspect-[16/10] overflow-hidden rounded-[24px] bg-black sm:aspect-[2/1]">
        <div class="screen-layer absolute inset-0">
          <video class="media-fit" muted loop playsinline preload="none" poster={first.thumb} data-src={first.src} data-autoplay aria-hidden="true"></video>
        </div>
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 z-[2] flex flex-wrap items-end justify-between gap-4 p-5 sm:p-8">
          <p class="reel-caption font-display text-2xl font-semibold tracking-tight text-white sm:text-4xl" aria-live="polite">{reels[0].title}</p>
          <button type="button" class="btn-accent reel-play">
            <svg width="14" height="14" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 1l7 4-7 4z" fill="currentColor" /></svg>
            Play with sound
          </button>
        </div>
      </div>

      <div class="mt-3 grid grid-cols-3 gap-2 sm:gap-3" role="group" aria-label="Choose a video">
        {reels.map((r, i) => (
          <button type="button" class="reel-tab group" data-id={r.id} data-cat={r.cat} aria-pressed={i === 0 ? 'true' : 'false'}>
            <span class="relative block aspect-[16/9] overflow-hidden rounded-xl bg-black">
              <img src={byId[r.id].thumb} alt="" width={byId[r.id].w} height={byId[r.id].h} loading="lazy" class="media-fit transition-transform duration-700 group-hover:scale-105" />
            </span>
            <span class="mt-2 block truncate text-left text-sm font-medium">{r.title}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .reel-tab { position: relative; padding: 0.4rem; border-radius: 16px; border: 1px solid transparent; transition: border-color 0.4s, background-color 0.4s; }
  .reel-tab[aria-pressed='true'] { border-color: var(--accent); background: rgb(255 255 255 / 0.7); }
  .reel-tab[aria-pressed='false'] img { opacity: 0.75; }
</style>
