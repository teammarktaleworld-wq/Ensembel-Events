---
import { nav, site, social } from '../data/site';
const mark = 'ENSEMBEL'.split('');
---

<footer class="relative z-[1] overflow-hidden border-t border-line bg-paper-2/85 pt-20 pb-10 backdrop-blur-sm">
  <div class="wrap">
    <div class="grid grid-cols-12 gap-x-6 gap-y-12">
      <div class="col-span-12 lg:col-span-5">
        <img src="/images/ensembel-logo.webp" alt="Ensembel Events" width="307" height="120" loading="lazy" class="h-14 w-auto" />
        <p class="mt-6 max-w-sm text-ink/65">Corporate, media and government events, planned and produced from New Delhi since {site.founded}.</p>
        <button type="button" data-open-enquiry class="btn-accent magnetic mt-8">Plan your event</button>
      </div>
      <nav class="col-span-6 sm:col-span-4 lg:col-span-2 lg:col-start-7" aria-label="Footer">
        <h2 class="text-xs font-medium tracking-[0.16em] text-ink/60 uppercase">Navigate</h2>
        <ul class="mt-4 space-y-1">
          {nav.map((n) => <li><a href={n.href} class="link-underline min-h-10 text-ink/85 hover:text-ink">{n.label}</a></li>)}
        </ul>
      </nav>
      <!-- CLIENT TO SUPPLY: social profile URLs -->
      <div class="col-span-6 sm:col-span-4 lg:col-span-2">
        <h2 class="text-xs font-medium tracking-[0.16em] text-ink/60 uppercase">Social</h2>
        <ul class="mt-4 space-y-1">
          {social.map((s) => <li><a href={s.href} class="link-underline min-h-10">{s.label}</a></li>)}
        </ul>
      </div>
      <div class="col-span-12 sm:col-span-4 sm:order-none lg:col-span-2">
        <h2 class="text-xs font-medium tracking-[0.16em] text-ink/60 uppercase">Contact</h2>
        <ul class="mt-4 space-y-1">
          <li><a href={site.phoneHref} class="link-underline min-h-10">{site.phone}</a></li>
          <li><a href={`mailto:${site.email}`} class="link-underline min-h-10 break-all">Email us</a></li>
          <li><a href={site.whatsapp} target="_blank" rel="noopener" class="link-underline min-h-10">WhatsApp</a></li>
        </ul>
      </div>
    </div>

    <p class="footer-mark mt-20 flex justify-between font-display text-[clamp(3.5rem,15.5vw,15rem)] leading-[0.8] font-semibold tracking-[-0.04em] text-ink select-none" aria-hidden="true">
      {mark.map((l) => <span class="fm-letter inline-block">{l}</span>)}
    </p>

    <div class="mt-10 flex flex-col gap-3 border-t border-line pt-6 text-sm text-ink/60 sm:flex-row sm:items-center sm:justify-between">
      <p>© 2026 Ensembel Events. All rights reserved.</p>
      <a href="#" class="link-underline min-h-10">Privacy policy</a>
    </div>
  </div>
</footer>

<a href={site.whatsapp} target="_blank" rel="noopener" class="wa-fab fixed right-5 bottom-5 z-[80] grid h-14 w-14 place-items-center rounded-full bg-[#1f9e55] text-white shadow-[0_12px_30px_-10px_rgba(20,20,22,0.45)] transition-[opacity,transform] duration-500 hover:scale-105" aria-label="Chat with us on WhatsApp">
  <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.4 5 5.2-1.4A9.9 9.9 0 1 0 12.04 2zm0 18.1a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3.1.8.8-3-.2-.3a8.2 8.2 0 1 1 7 3.9zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.8-1.4.1-.2 0-.3 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.2.7a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z" /></svg>
</a>

<style>
  .wa-fab.is-obscured { opacity: 0; transform: translateY(16px) scale(0.9); pointer-events: none; }
  :global(.js-motion) .fm-letter { transform: translateY(105%); }
  .footer-mark { overflow: hidden; padding-bottom: 0.04em; }
</style>
