---
import Base from '../layouts/Base.astro';
import Backdrop from '../components/Backdrop.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Clients from '../components/Clients.astro';
import Services from '../components/Services.astro';
import Showreel from '../components/Showreel.astro';
import Gallery from '../components/Gallery.astro';
import Process from '../components/Process.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import Enquiry from '../components/Enquiry.astro';
---

<Base>
  <Backdrop />
  <Header />
  <main id="main" class="relative z-[1]">
    <Hero />
    <Clients />
    <Services />
    <Showreel />
    <Gallery />
    <Process />
    <Contact />
  </main>
  <Footer />
  <Lightbox />
  <Enquiry />
  <script>
    import { initApp } from '../scripts/main';
    initApp();
  </script>
</Base>
