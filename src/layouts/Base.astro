---
import '../styles/global.css';
import { site } from '../data/site';

const origin = (Astro.site ?? new URL(site.url)).origin;
const ogImage = `${origin}/images/og.jpg`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  url: site.url,
  telephone: site.phone,
  email: site.email,
  foundingDate: String(site.founded),
  image: ogImage,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    postalCode: site.address.postcode,
    addressCountry: site.address.country,
  },
  areaServed: 'IN',
};
---

<!doctype html>
<html lang="en-IN" data-cat="all">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={site.url} />
    <meta name="theme-color" content="#faf8f4" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={`${origin}/`} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ensembel Events — corporate and government event management, New Delhi" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- Decide before first paint whether motion is allowed. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('js-motion');
        // Safety net: if the app script never starts, show content without motion.
        setTimeout(function () { if (!window.__eeReady) d.classList.remove('js-motion'); }, 4000);
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only z-[200] rounded bg-gold px-4 py-3 font-semibold text-ink focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Skip to content</a>
    <slot />
  </body>
</html>
